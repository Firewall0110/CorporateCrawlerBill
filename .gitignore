# Persistent leaderboard JSON file (lives at data/leaderboard.json by default
# or wherever LEADERBOARD_PATH points). Don't commit the data itself - on
# Railway this should live on a mounted Volume so it survives redeploys.
data/leaderboard.json
data/leaderboard.json.tmp
data/leaderboard.json.backup

# Build-at-deploy: the React client is rebuilt from src/ at deploy time via
# railway.json's buildCommand ("npm run build"). We no longer commit build/
# because a committed artifact silently drifts from src/ and gets served stale
# (this caused the attribute-picker/sprite regression). src/ + public/ are the
# single source of truth. To preview a production bundle locally: npm run build.
build/
